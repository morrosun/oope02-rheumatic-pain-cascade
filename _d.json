{"created": "2026-11-14T02:33:08.862481+00:00", "modified": "2026-11-14T02:33:09.304797+00:00", "id": 24211370, "conceptrecid": "24211369", "doi": "10.5281/zenodo.24211370", "conceptdoi": "10.5281/zenodo.24211369", "doi_url": "https://doi.org/10.5281/zenodo.24211370", "metadata": {"title": "Analysis code for: The rheumatic pain care cascade across seven ageing cohorts", "doi": "10.5281/zenodo.24211370", "publication_date": "2026-11-14", "description": "Python and R code for a cross-national analysis of the rheumatic pain care cascade (pain to diagnosis to treatment) in seven harmonised ageing cohorts: CHARLS, ELSA, HRS, KLoSA, LASI, MHAS and SHARE. The repository contains the cascade construction, weighted and age-standardised rates with cluster-bootstrap confidence intervals, cohort-specific logistic models pooled with DerSimonian-Laird random effects, functional-outcome models, the CHARLS wave 6 validation of incident diagnosis, sensitivity analyses, and the three figure scripts. No respondent-level data are included. Source repository: https://github.com/morrosun/oope02-rheumatic-pain-cascade (tag v1.0.0).", "access_right": "open", "creators": [{"name": "Wang, Kai", "affiliation": "The Affiliated Huai'an No.1 People's Hospital of Nanjing Medical University, Huai'an, Jiangsu, China"}], "keywords": ["care cascade", "arthritis", "rheumatic pain", "musculoskeletal pain", "ageing cohorts", "cross-national comparison", "undiagnosed disease"], "related_identifiers": [{"identifier": "https://github.com/morrosun/oope02-rheumatic-pain-cascade/tree/v1.0.0", "relation": "isSupplementedBy", "resource_type": "software", "scheme": "url"}], "version": "1.0.0", "language": "eng", "license": "mit-license", "imprint_publisher": "Zenodo", "upload_type": "software", "prereserve_doi": {"doi": "10.5281/zenodo.24211370", "recid": 24211370}}, "title": "Analysis code for: The rheumatic pain care cascade across seven ageing cohorts", "links": {"self": "https://zenodo.org/api/records/242113